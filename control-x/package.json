{
  "name": "control-x",
  "version": "0.1.0",
  "private": true,
  "description": "Cut out the junk. Text-only local AI filtering for X.",
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test tests/browser/control-x.test.cjs",
    "lint": "node scripts/check-manifest.mjs",
    "zip": "node scripts/zip.mjs",
    "models": "node scripts/fetch-models.mjs",
    "setup": "npm run vendor && npm run models",
    "eval": "node eval/run.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1"
  }
}
