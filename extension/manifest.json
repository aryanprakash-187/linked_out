{
  "manifest_version": 3,
  "name": "control.",
  "short_name": "control.",
  "version": "0.1.0",
  "description": "Decide what gets your attention on LinkedIn. Hide promoted posts, network activity, keywords, or anything you describe.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "control.",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["shared/settings.js", "shared/rules.js", "content/linkedin.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120"
}
